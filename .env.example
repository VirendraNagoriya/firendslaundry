APP_NAME="Laundry Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laundry_platform
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SMS gateway (TextBee). The API key is a secret: keep it in the server
# environment only. Never expose it to JavaScript and never commit it.
# Set SMS_DRIVER=log to run without a gateway phone (OTP is written to
# storage/logs/laravel.log instead of being sent).
# ---------------------------------------------------------------------------
SMS_DRIVER=textbee
SMS_FROM_LAUNDRY="Laundry"
TEXTBEE_API_KEY=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1/gateway/send-sms
TEXTBEE_TIMEOUT=10

# OTP policy
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS_PER_HOUR=3

# ---------------------------------------------------------------------------
# Authentication: Google OAuth and password accounts
# ---------------------------------------------------------------------------
# Sign-in is handled by this app. Google verifies the person; this app then
# decides which laundry they belong to. See docs/GOOGLE_AUTH_SETUP.md for
# the Google Cloud Console screens and the exact redirect URI.

# Client ID and secret from Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID -> "Web application".
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on the OAuth client exactly,
# including scheme, port and any trailing slash.
#   local:  http://127.0.0.1:8000/auth/google/callback
#   hosted: https://your-domain.example/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# First-party email + password accounts.
PASSWORD_AUTH_ENABLED=true
PASSWORD_MIN_LENGTH=12

# Set to false to stop new customers signing themselves up. Staff accounts
# are always created by an Admin and are unaffected by this.
OPEN_CUSTOMER_REGISTRATION=true

# Brute-force protection for password sign-in.
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15

# Wording on the sign-in screen for the code printed on a bill.
BUSINESS_CODE_LABEL=Laundry code
BUSINESS_CODE_PLACEHOLDER=e.g. ABC
